{
  "name": "unideploy-monorepo",
  "version": "0.2.4",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/ai",
    "packages/agent",
    "packages/cli",
    "apps/worker",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npx tsx packages/cli/src/cli.ts",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "deploy:worker": "npm run deploy --workspace=apps/worker",
    "check": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:cli": "npm run typecheck --workspace=packages/cli",
    "typecheck:worker": "npm run typecheck --workspace=apps/worker"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
